# AgentClaim contract addresses (one per chain).
# Copy this file to .env for local dev, or set the same variables in the
# Vercel dashboard (Project -> Settings -> Environment Variables) and redeploy.
# Leave an address empty and the site shows a "deploy pending" state for that
# chain instead of crashing.

# BNB Chain Testnet (chain 97) — the default demo network.
VITE_AGENTCLAIM_ADDRESS_97=

# BNB Chain (chain 56).
VITE_AGENTCLAIM_ADDRESS_56=

# Optional fallback: used on the default chain when its per-chain var is empty.
VITE_AGENTCLAIM_ADDRESS=

# Default chain: 97 (testnet) or 56. Defaults to 97 when unset.
VITE_AGENTCLAIM_CHAIN_ID=97
